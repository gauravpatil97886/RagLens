# --- Gemini (Google AI Studio free tier) ---
# Get a free key at https://aistudio.google.com/apikey and paste it below.
GEMINI_API_KEY=your-key-here

# gemini-flash-latest always points at the newest Flash model.
GEMINI_CHAT_MODEL=gemini-flash-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# gemini-embedding-001 emits 3072 dims by default. We truncate to 768 (Matryoshka)
# because pgvector's HNSW index only supports up to 2000 dims.
# Truncated vectors are NOT normalized by Google -- we L2-normalize them ourselves.
EMBED_DIM=768

# --- Postgres (pgvector) ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag
POSTGRES_DB=rag
POSTGRES_PORT=5433
DATABASE_URL=postgresql://rag:rag@localhost:5433/rag

# --- RAG tuning ---
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
TOP_K=5
MIN_SIMILARITY=0.25

# --- Semantic cache ---
# A new question is embedded anyway for retrieval, so we reuse that vector to look for a
# previously-asked question that means the same thing. >= threshold -> replay the cached
# answer and skip the generation API call entirely.
# 0.95 is deliberately strict; drop to ~0.90 to see more hits (and more false hits).
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.87
CACHE_TTL_HOURS=168
